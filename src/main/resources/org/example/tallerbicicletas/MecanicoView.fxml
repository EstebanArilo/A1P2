<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" style="-fx-background-color: #f0fdf4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tallerbicicletas.model.MecanicoController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #15803d; -fx-padding: 15px 25px;" BorderPane.alignment="CENTER">
            <children>
                <Button onAction="#onVolverMenu" style="-fx-background-color: #166534; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="← Menú Principal" />
                <Label text="🛠 PANORAMA MECÁNICO Y ÓRDENES DE SERVICIO" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>
    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <!-- COLUMNA IZQUIERDA: GESTIÓN DE MECÁNICOS Y SUS ÓRDENES -->
                <VBox prefWidth="480.0" spacing="15.0">
                    <children>
                        <!-- TARJETA REGISTRO MECÁNICO -->
                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #dcfce7; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <children>
                                <Label text="Datos del Mecánico" textFill="#15803d">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <GridPane hgap="10.0" vgap="8.0">
                                    <children>
                                        <Label text="Cédula / ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtIdMecanico" promptText="Ej: 1098123" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtNombreMecanico" promptText="Nombre completo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtTelefonoMecanico" promptText="3109876543" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <Label text="N° Certificación:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <TextField fx:id="txtCertificacionMecanico" promptText="Ej: 4552" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                        <Label text="Especialidad:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                        <ComboBox fx:id="cbEspecializacion" maxWidth="1.5E308" promptText="Seleccionar..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    </children>
                                </GridPane>
                                <HBox alignment="CENTER" spacing="8.0">
                                    <padding>
                                        <Insets top="5.0" />
                                    </padding>
                                    <children>
                                        <Button onAction="#onRegistrarMecanico" prefHeight="30.0" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Registrar" />
                                        <Button onAction="#onActualizarMecanico" prefHeight="30.0" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Actualizar" />
                                        <Button onAction="#onEliminarMecanico" prefHeight="30.0" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Eliminar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- TABLA MECÁNICOS -->
                        <VBox spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #dcfce7; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Mecánicos Registrados (Seleccionar para asignar/ver órdenes)" textFill="#15803d">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="tblMecanicos" prefHeight="150.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colIdMecanico" prefWidth="75.0" text="ID" />
                                        <TableColumn fx:id="colNombreMecanico" prefWidth="120.0" text="Nombre" />
                                        <TableColumn fx:id="colTelefonoMecanico" prefWidth="90.0" text="Teléfono" />
                                        <TableColumn fx:id="colEspecializacion" prefWidth="100.0" text="Especialidad" />
                                        <TableColumn fx:id="colCertificacion" prefWidth="80.0" text="Certificado" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- COLUMNA DERECHA: CREACIÓN Y LISTADO DE ÓRDENES -->
                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <!-- FORMULARIO ORDEN DE SERVICIO -->
                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #dcfce7; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <children>
                                <Label text="Crear Orden de Servicio para Mecánico Seleccionado" textFill="#15803d">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <GridPane hgap="10.0" vgap="8.0">
                                    <children>
                                        <Label text="N° Orden:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtIdOrden" promptText="Ej: 501" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Fecha Ingreso:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <DatePicker fx:id="dpFechaIngreso" maxWidth="1.5E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Hora (HH:mm):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtHoraIngreso" promptText="Ej: 14:30" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <Label text="Bicicleta:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <ComboBox fx:id="cbBicicletaOrden" maxWidth="1.5E308" promptText="Seleccionar Bicicleta..." GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                        <Label text="Motivo:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                        <TextArea fx:id="txtMotivoServicio" prefHeight="40.0" promptText="Motivo del servicio" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                        <Label text="Diagnóstico:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                        <TextArea fx:id="txtDiagnostico" prefHeight="40.0" promptText="Diagnóstico inicial" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                        <Label text="Trabajos:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                                        <TextArea fx:id="txtTrabajosRealizados" prefHeight="40.0" promptText="Reparaciones/Ajustes" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                                        <Label text="Costo Total ($):" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                                        <TextField fx:id="txtCostoTotal" promptText="Ej: 85000" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                                    </children>
                                </GridPane>
                                <Button maxWidth="1.5E308" onAction="#onCrearOrdenServicio" prefHeight="32.0" style="-fx-background-color: #65a30d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+ REGISTRAR ÓRDEN DE SERVICIO">
                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>

                        <!-- TABLA ÓRDENES ASIGNADAS AL MECÁNICO -->
                        <VBox spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #dcfce7; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="📋 Órdenes Asignadas al Mecánico Seleccionado" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="tblOrdenesMecanico" prefHeight="130.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colIdOrden" prefWidth="70.0" text="N° Orden" />
                                        <TableColumn fx:id="colFechaOrden" prefWidth="90.0" text="Fecha" />
                                        <TableColumn fx:id="colMotivoOrden" prefWidth="180.0" text="Motivo" />
                                        <TableColumn fx:id="colCostoOrden" prefWidth="90.0" text="Costo" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
