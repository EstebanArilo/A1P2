<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #f0fdf4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tallerbicicletas.model.ClienteController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #15803d; -fx-padding: 15px 25px;" BorderPane.alignment="CENTER">
            <children>
                <Button onAction="#onVolverMenu" style="-fx-background-color: #166534; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="← Menú Principal" />
                <Label text="🚲 MÓDULO DE CLIENTES Y BICICLETAS" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>
    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <!-- COLUMNA IZQUIERDA: FORMULARIOS -->
                <VBox prefWidth="380.0" spacing="15.0">
                    <children>
                        <!-- TARJETA CLIENTE -->
                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #dcfce7; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <children>
                                <Label text="Gestión de Cliente" textFill="#15803d">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <GridPane hgap="10.0" vgap="8.0">
                                    <children>
                                        <Label text="Cédula / ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtIdCliente" promptText="Ej: 1094123" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtNombreCliente" promptText="Nombre completo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtTelefonoCliente" promptText="3001234567" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <TextField fx:id="txtDireccionCliente" promptText="Calle / Carrera" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    </children>
                                </GridPane>
                                <HBox alignment="CENTER" spacing="8.0">
                                    <padding>
                                        <Insets top="5.0" />
                                    </padding>
                                    <children>
                                        <Button onAction="#onRegistrarCliente" prefHeight="30.0" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Registrar" />
                                        <Button onAction="#onActualizarCliente" prefHeight="30.0" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Actualizar" />
                                        <Button onAction="#onEliminarCliente" prefHeight="30.0" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Eliminar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- TARJETA BICICLETA -->
                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #dcfce7; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <children>
                                <Label text="Registro de Bicicleta (Seleccionar Cliente)" textFill="#15803d">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <GridPane hgap="10.0" vgap="8.0">
                                    <children>
                                        <Label text="N° Serial / Marco:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtSerialBici" promptText="Ej: 98765" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Marca:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtMarcaBici" promptText="Ej: Trek, Specialized" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Color:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtColorBici" promptText="Ej: Negro, Rojo" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <Label text="Año:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <TextField fx:id="txtAnoBici" promptText="Ej: 2024" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                        <Label text="Tipo Bici:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                        <ComboBox fx:id="cbTipoBici" maxWidth="1.5E308" promptText="Seleccionar..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    </children>
                                </GridPane>
                                <Button maxWidth="1.5E308" onAction="#onRegistrarBicicleta" prefHeight="32.0" style="-fx-background-color: #65a30d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+ VINCULAR BICICLETA A CLIENTE">
                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- COLUMNA DERECHA: TABLA Y NOTIFICACIONES -->
                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <!-- TABLA CLIENTES -->
                        <VBox spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #dcfce7; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Listado de Clientes Registrados" textFill="#15803d">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="tblClientes" prefHeight="220.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colIdCliente" prefWidth="90.0" text="Identificación" />
                                        <TableColumn fx:id="colNombreCliente" prefWidth="150.0" text="Nombre" />
                                        <TableColumn fx:id="colTelefonoCliente" prefWidth="100.0" text="Teléfono" />
                                        <TableColumn fx:id="colDireccionCliente" prefWidth="140.0" text="Dirección" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- NOTIFICACIONES (INotificable) -->
                        <VBox prefHeight="160.0" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: #dcfce7; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <children>
                                <Label text="🔔 Historial de Notificaciones del Cliente" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <ListView fx:id="listNotificacionesView" prefHeight="110.0" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
